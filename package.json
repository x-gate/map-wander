{
  "name": "map-wander",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run dev",
    "dev": "bun run build:wasm && vite",
    "build:wasm": "bun scripts/build-wasm.ts",
    "build": "bun run build:wasm && bun run lint && bun run typecheck && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "audit:local": "bun scripts/audit-local.ts ../CGoriginmood",
    "format": "prettier --write src scripts tests index.html public/style.css vite.config.ts README.md package.json"
  },
  "dependencies": {
    "pixi.js": "^8.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0"
  }
}
